# Greenova backend: your MySQL login.
# Copy this file to .env (start-backend.bat does it for you) and type your MySQL password after
# DB_PASSWORD=. Nothing else is needed: the first time the backend starts, it creates the
# greenova_db database and its tables by itself. (You can also type these in app/config.py.)

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=greenova_db
