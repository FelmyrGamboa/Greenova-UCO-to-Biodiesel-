[Unit]
Description=Greenova backend
After=network-online.target
Wants=network-online.target

[Service]
# TODO: change "pi" and the paths to your Pi's username and folder
User=pi
WorkingDirectory=/home/pi/greenova-backend
Environment=GREENOVA_MOCK=0
ExecStart=/home/pi/greenova-backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
