# Greenova backend as a service: starts when the Pi boots, restarts if it stops.
# setup-pi.sh fills in __USER__ and __BACKEND__ and installs it. By hand: replace them with your
# username (e.g. pi) and the backend folder (e.g. /home/pi/Greenova-UCO-to-Biodiesel-/backend), then
#     sudo cp greenova.service /etc/systemd/system/ && sudo systemctl daemon-reload
#     sudo systemctl enable --now greenova
[Unit]
Description=Greenova backend
# The MySQL 8 database must be up first when it runs on the Pi. Units that don't exist are ignored.
After=network-online.target mysql.service
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__BACKEND__
# Demo mode (simulated process, no physical outputs). Use this until wiring and interlocks
# are finalized and bench-tested. The website is still served live on the Pi over Wi-Fi.
# The MySQL login defaults to greenova@localhost (greenova_db_ver2.sql); override it in __BACKEND__/.env.
Environment=GREENOVA_MOCK=1
ExecStart=__BACKEND__/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
# Also restarts when MySQL wasn't reachable yet at boot.
Restart=on-failure
RestartSec=5
# If later configured for hardware mode, the backend shutdown handler must switch outputs off.
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
